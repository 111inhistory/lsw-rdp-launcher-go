// niri >= 26.04. Only the RDP Launcher confirmation dialog is affected.
// The dialog is embedded directly in the rdp-launcher CLI binary.
// The application draws an alpha background, not globally faded text/buttons.
window-rule {
    match app-id="^rdp-launcher$"
    open-floating true
    // Inherit the desktop/DMS corner radius instead of overriding it.
    clip-to-geometry true
    // Otherwise the focus ring's opaque fill can cover the wallpaper effect.
    draw-border-with-background false
    background-effect {
        // Match the sharp wallpaper backdrop of DMS settings; no forced fog.
        blur false
        // Show wallpaper, not terminal text from windows underneath.
        xray true
    }
}
